// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Credential {
  id           String   @id @default(uuid()) // Internal DB ID
  userId       String   @unique // Every credential is linked to a specific user
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  credentialId String   @unique // WebAuthn credential identifier
  publicKey    Bytes
  counter      Int      @default(0)

  @@index([credentialId])
  @@index([userId])
}

model Form {
  id                   String         @id @default(uuid())
  title                String
  description          String?
  street               String?
  city                 String?
  state                String?
  zip                  String?
  useMultipleAddresses Boolean        @default(false)
  showMap              Boolean        @default(false)
  useMultipleDates     Boolean        @default(false)
  useMultipleTimes     Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  signupOptions        SignupOption[]
}

model SignupOption {
  id          String               @id @default(uuid())
  formID      String
  form        Form                 @relation(fields: [formID], references: [id])
  title       String
  slots       Int
  description String?
  startDate   DateTime?
  endDate     DateTime?
  startTime   DateTime?
  endTime     DateTime?
  location    String?
  registrants Registrant[]
  checkboxes  SignupOptionDetail[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model SignupOptionDetail {
  id             String       @id @default(uuid())
  title          String
  signupOptionID String
  signupOption   SignupOption @relation(fields: [signupOptionID], references: [id])
  checked        Boolean      @default(false)
  registrants    Registrant[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Registrant {
  id                   String              @id @default(uuid())
  avatar               String?
  firstName            String
  lastName             String
  email                String
  phone                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  signupOptionDetailId String?
  signupOptionDetail   SignupOptionDetail? @relation(fields: [signupOptionDetailId], references: [id])
  signupOptionID       String
  signupOption         SignupOption        @relation(fields: [signupOptionID], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        String   @id @default(uuid()) // User ID (UUID-based)
  username  String   @unique
  createdAt DateTime @default(now())
  firstName String
  lastName  String
  avatar    String?
  email     String   @unique
  forms     Form[]
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  credentials Credential[] // Relationship: One user can have many credentials
}
